#!/usr/bin/env python3
"""Fake agent: each run plays the next scenario step, then stops, as a dead process would."""
import json
import os
import subprocess
import sys
from pathlib import Path

calls = Path(os.environ["FAKE_CLAUDE_CALLS"])
with calls.open("a") as out:
    out.write(json.dumps(sys.argv[1:]) + "\n")
run = len(calls.read_text().splitlines()) - 1
steps = json.loads(Path(os.environ["FAKE_CLAUDE_SCENARIO"]).read_text())
if run >= len(steps):
    sys.exit(1)
step = steps[run]
subprocess.run(step.get("sh", "true"), shell=True, check=True, stdout=subprocess.DEVNULL)
print(json.dumps({"type": "assistant", "message": {"content": [{"type": "text", "text": f"step {run}"}]}}))
for event in step.get("events", []):
    print(json.dumps(event))
print(json.dumps({
    "type": "result",
    "subtype": "success",
    "duration_ms": 61000,
    "total_cost_usd": 0.5,
    "session_id": f"session-{run}",
    "structured_output": step["report"],
}))
