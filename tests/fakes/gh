#!/usr/bin/env python3
"""Fake GitHub: issues and pull requests in a JSON file, merges into the local origin."""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

state_file = Path(os.environ["FAKE_GH_STATE"])
state = json.loads(state_file.read_text())
args = sys.argv[1:]


def flag(name):
    return args[args.index(name) + 1]


def save():
    state_file.write_text(json.dumps(state))


match args[:2]:
    case ["repo", "view"]:
        allowed = state.get("merge_methods", ["merge", "squash", "rebase"])
        print(json.dumps({
            "nameWithOwner": "acme/widget", "defaultBranchRef": {"name": "main"},
            "mergeCommitAllowed": "merge" in allowed, "squashMergeAllowed": "squash" in allowed,
            "rebaseMergeAllowed": "rebase" in allowed,
        }))
    case ["issue", "list"]:
        state["labels"] = state.get("labels", []) + [flag("--label")]
        save()
        print(json.dumps([{"number": int(n)} for n, i in state["issues"].items()
                          if i["state"] == "OPEN" or i.get("stale")]))
    case ["api", path] if path.endswith("/dependencies/blocked_by"):
        issues = state["issues"]
        blockers = issues[path.split("/")[-3]].get("blocked_by", [])
        print(json.dumps([{"number": n, "state": issues[str(n)]["state"].lower()} for n in blockers]))
    case ["api", path]:
        issue = state["issues"][path.rsplit("/", 1)[1]]
        print(json.dumps({"title": issue["title"], "issue_dependencies_summary": {"blocked_by": issue["blocked"]}}))
    case ["issue", "view"]:
        print(json.dumps({"state": state["issues"][args[2]]["state"]}))
    case ["issue", "close"]:
        state["issues"][args[2]]["state"] = "CLOSED"
        if "--comment" in args:
            state["issues"][args[2]]["comment"] = flag("--comment")
        save()
    case ["pr", "view"]:
        sys.exit(1)
    case ["pr", "create"]:
        url = f"https://fake/pr/{len(state['prs']) + 1}"
        state["prs"][url] = {"branch": flag("--head"), "title": flag("--title"), "body": flag("--body")}
        save()
        print(url)
    case ["pr", "merge"]:
        pr = state["prs"][args[2]]
        origin = os.environ["FAKE_ORIGIN"]
        subprocess.run(["git", "-C", origin, "update-ref", "refs/heads/main", f"refs/heads/{pr['branch']}"], check=True)
        pr["merged"] = args[3]
        if closes := re.search(r"Closes #(\d+)", pr["body"]):
            state["issues"][closes[1]]["state"] = "CLOSED"
        save()
    case _:
        sys.exit(f"fake gh: unhandled {args}")
